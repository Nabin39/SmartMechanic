# Copy this file to `.env` and fill in values from your Firebase project (Project settings > General > Your apps).
# Add a **Web** app in Firebase Console to get the values below (google-services.json is Android-only).
# Expo embeds EXPO_PUBLIC_* variables in the client bundle — restrict keys in Firebase Console (API key restrictions, App Check).
# Never commit `.env` or production secrets.

# Example project id when using repo google-services.json (Android package: com.smartmechanic.bookingapp):
EXPO_PUBLIC_FIREBASE_PROJECT_ID=smart-mechanic-booking-app

EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=smart-mechanic-booking-app.firebaseapp.com
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=smart-mechanic-booking-app.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=729916399444
EXPO_PUBLIC_FIREBASE_APP_ID=1:729916399444:web:YOUR_WEB_APP_ID_FROM_CONSOLE

# Optional: Google Maps SDK key (Android/iOS) — restrict by package name and SHA-1
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_maps_key
